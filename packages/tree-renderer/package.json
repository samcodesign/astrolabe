{
  "name": "@poe-planner/tree-renderer",
  "version": "0.1.0",
  "description": "High-performance PixiJS passive tree renderer for poe-planner",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/tree-renderer.js",
  "module": "./dist/tree-renderer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tree-renderer.js"
    },
    "./style.css": "./dist/tree-renderer.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8"
  }
}
