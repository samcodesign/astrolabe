{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astrolabe",
  "version": "0.2.0",
  "identifier": "dev.astrolabe.app",
  "build": {
    "beforeDevCommand": "npm --prefix app run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../tools/stage-bundle.mjs && npm run build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Astrolabe",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0B0D11"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost treedata: http://treedata.localhost; connect-src 'self' ipc: http://ipc.localhost treedata: http://treedata.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "bundle-resources/engine-host.exe": "engine-host.exe",
      "bundle-resources/pob-updater.exe": "pob-updater.exe",
      "bundle-resources/lua": "lua"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
